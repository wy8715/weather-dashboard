# ============================================================
# Docker 部署环境变量模板
# 复制为 .env.docker 后填入真实值
# docker compose 使用: docker compose --env-file .env.docker up -d
# ============================================================

# 和风天气 API Key（必填）
QWEATHER_API_KEY=your_qweather_api_key_here

# 和风天气 API Host（必填）
QWEATHER_API_HOST=your-api-host.example.com

# 默认城市 LocationID
DEFAULT_LOCATION_ID=101020100

# 默认城市名称
DEFAULT_CITY_NAME=上海

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 数据保留天数
SNAPSHOT_RETENTION_DAYS=90
