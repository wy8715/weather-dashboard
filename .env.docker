# ============================================================
# Docker 部署环境变量模板
# 复制为 .env 后填入真实值（docker compose 默认读取同目录 .env）
# 启动命令：docker compose up -d
# ============================================================

# ---------- 和风天气 JWT 认证（必填）----------
# JWT 凭据 ID（控制台-项目管理-JWT 凭据）
QWEATHER_JWT_CREDENTIAL_ID=your_jwt_credential_id_here

# 项目 ID（控制台-项目管理）
QWEATHER_JWT_PROJECT_ID=your_project_id_here

# 开发者 ID（控制台-设置，以 Q 开头）
QWEATHER_JWT_DEVELOPER_ID=Qyour_developer_id_here

# 和风天气 API Host（必填，不含 https://）
QWEATHER_API_HOST=your-api-host.example.com

# Ed25519 私钥在宿主机上的路径（相对于本项目根目录）
QWEATHER_JWT_PRIVATE_KEY_HOST_PATH=./secrets/ed25519-private.pem

# ---------- 服务配置 ----------
# 默认城市 LocationID
DEFAULT_LOCATION_ID=101020100

# 默认城市名称
DEFAULT_CITY_NAME=上海

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 数据保留天数
SNAPSHOT_RETENTION_DAYS=90
