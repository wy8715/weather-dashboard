# ============================================================
# 和风天气 JWT 认证配置（Ed25519）
# 控制台：https://console.qweather.com/project
# ============================================================

# JWT 凭据 ID（控制台-项目管理-JWT 凭据，对应 JWT Header 的 kid）
QWEATHER_JWT_CREDENTIAL_ID=your_jwt_credential_id_here

# 项目 ID（控制台-项目管理，对应 JWT Payload 的 sub）
QWEATHER_JWT_PROJECT_ID=your_project_id_here

# 开发者 ID（控制台-设置，以 Q 开头，对应 JWT Payload 的 iss）
QWEATHER_JWT_DEVELOPER_ID=Qyour_developer_id_here

# Ed25519 私钥文件路径（推荐，路径相对 server 目录或使用绝对路径）
QWEATHER_JWT_PRIVATE_KEY_PATH=./secrets/ed25519-private.pem

# 也可以直接提供 PEM 私钥内容，换行使用 \n 表示；设置后优先于文件路径
# QWEATHER_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# 和风天气控制台分配的专属 API Host（不要带 https://）
QWEATHER_API_HOST=your-api-host.example.com

# 服务端口（生产环境建议 4000）
PORT=4000

# 默认城市 LocationID
DEFAULT_LOCATION_ID=101010100

# 默认城市名称
DEFAULT_CITY_NAME=北京

# 数据库文件路径
DB_PATH=./data/weather.db

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 数据保留天数
SNAPSHOT_RETENTION_DAYS=90

# CORS 允许的源（多个用逗号分隔，生产环境 Nginx 同域部署时可为空）
CORS_ORIGINS=
